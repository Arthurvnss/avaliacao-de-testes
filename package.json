{
  "name": "avaliacao-testes-cypress",
  "version": "1.0.0",
  "private": true,
  "description": "Respostas das questoes 1, 2 e 3 da avaliacao de testes usando Cypress",
  "scripts": {
    "cy:open": "cypress open",
    "test:q1": "cypress run --spec cypress/e2e/questao01_saucedemo.cy.js",
